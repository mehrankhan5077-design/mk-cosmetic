# Server & Database
PORT=5000
FRONTEND_URL=http://localhost:3000
# Leave MONGODB_URI empty in local dev to auto-start persistent local mongod via mongodb-memory-server,
# or set your MongoDB Atlas / local MongoDB connection string:
MONGODB_URI=
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Cloud Image Storage (Cloudinary) - optional; falls back to local /uploads when unset
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Bank Transfer Instructions (Shown to customer when choosing Bank Transfer)
BANK_NAME=Meezan Bank Limited
BANK_ACCOUNT_TITLE=MK COSMETIC MARKETPLACE
BANK_ACCOUNT_NUMBER=0102-0109988776
BANK_IBAN=PK45MEZN0001020109988776

# JazzCash Payment Gateway (Integration-Ready)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:3000/checkout/callback?gateway=jazzcash
JAZZCASH_SANDBOX=true

# Easypaisa Payment Gateway (Integration-Ready)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:3000/checkout/callback?gateway=easypaisa
EASYPAISA_SANDBOX=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5000/api
